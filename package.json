{
  "name": "pineapple-ai-browser",
  "version": "0.1.0",
  "description": "Lightweight, AI-native desktop web browser built with Electron, React, TypeScript, and Vite.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "compile": "tsc --project tsconfig.main.json && tsc --project tsconfig.json --noEmit",
    "build": "vite build --config vite.config.ts && tsc --project tsconfig.main.json",
    "start": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "electron": "^33.2.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
